# URL pública final, sem barra no fim. Usada em canonical, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL=https://vlopcas.dev

# Mantenha false até decidir liberar o site para mecanismos de busca.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Preencha depois com o token fornecido pelo Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
